[submodule "riscv-isa-manual"]
	path = riscv-isa-manual
	url = https://github.com/riscv/riscv-isa-manual.git
	# The build patches zvknhk.adoc into src/ in place (see scripts/apply-patch.sh),
	# which dirties the submodule work tree. Ignore that so `git status` stays clean;
	# a changed pinned commit still shows up.
	ignore = dirty
[submodule "riscv-isa-sim"]
	path = riscv-isa-sim
	url = https://github.com/riscv-software-src/riscv-isa-sim.git
	# The build patches the Zvknhk instruction into riscv/ and disasm/ in place
	# (see scripts/apply-spike-patch.sh), which dirties the submodule work tree.
	# Ignore that so `git status` stays clean; a changed pinned commit still shows.
	ignore = dirty
[submodule "qemu-src"]
	path = qemu-src
	url = https://gitlab.com/qemu-project/qemu.git
	# The build patches the Zvknhk instruction into target/riscv/ in place
	# (see scripts/apply-qemu-patch.sh), which dirties the submodule work tree.
	# Ignore that so `git status` stays clean; a changed pinned commit still shows.
	ignore = dirty
[submodule "demo/openssl"]
	path = demo/openssl
	url = https://github.com/openssl/openssl.git
	# The build patches the Zvknhk Keccak backend into crypto/sha/ and the RISC-V
	# capability table in place (see scripts/apply-openssl-patch.sh), and builds
	# in demo/openssl/build. Ignore that so `git status` stays clean; a changed
	# pinned commit still shows.
	ignore = dirty
	# OpenSSL's full history is large and only one release is ever needed here.
	shallow = true
